# 复制为仓库根 .local/toolchain.env；本机路径不提交。
export AIW_BUILD_DIR="${AIW_BUILD_DIR:-C:/wbuild/aiw}"
export AIW_TOOLCHAIN="${AIW_TOOLCHAIN:-C:/path/to/android-tools}"
export AIW_SDK_DIR="${AIW_SDK_DIR:-C:/wbuild/sdk}"
export AIW_BUILD_PYTHON="${AIW_BUILD_PYTHON:-C:/wbuild/py314/python.exe}"
export AIW_MAVEN_DIR="${AIW_MAVEN_DIR:-C:/wbuild/local-maven}"
